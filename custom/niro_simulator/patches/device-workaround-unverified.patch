diff --git a/custom/niro_dashboard/launch.sh b/custom/niro_dashboard/launch.sh
index cdae7fa..7d619cb 100755
--- a/custom/niro_dashboard/launch.sh
+++ b/custom/niro_dashboard/launch.sh
@@ -8,4 +8,12 @@ export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
 mkdir -p /data/local/niro-dashboard
 cd "$(dirname "$0")"
 export PWD="$PWD"
-exec ./niro-dashboard "$@"
+# Qualcomm Wayland crashes when a previously hidden EGL surface is reused.
+# Exit 42 retires that process; the replacement waits for eligible fresh data.
+set +e
+while :; do
+  ./niro-dashboard "$@"
+  dashboard_status=$?
+  [ "$dashboard_status" -eq 42 ] || exit "$dashboard_status"
+  sleep 0.1
+done
